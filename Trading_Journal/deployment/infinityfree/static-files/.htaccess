DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS without creating a redirect loop when the hosting proxy has
  # already terminated TLS for the request.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Next.js is exported as real files and route directories (for example,
  # /login/index.html and /journal/index.html). Never rewrite those paths or
  # anything under /_next, otherwise CSS, JavaScript, and PDF assets can break.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Use the generated Next.js error page for genuinely missing files/routes.
ErrorDocument 404 /404.html
