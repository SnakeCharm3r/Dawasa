# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical browser origin used after Google/email authentication.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary signup mode. Keep false to create immediately-confirmed accounts;
# change to true when email confirmation is restored.
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
INTERNAL_SYNC_API_TOKEN=replace-with-a-long-random-secret

# Optional dedicated key for AES-256-GCM broker-password encryption. Use a
# random value of at least 32 bytes. If omitted, the server derives a separate
# encryption key from SUPABASE_SECRET_KEY.
BROKER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
