# Browser-safe Supabase configuration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Canonical browser origin used after Google/email authentication.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary signup mode. Keep false to create immediately-confirmed accounts;
# change to true when email confirmation is restored.
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# Use the deployed Supabase Edge Function for registration on static hosting.
# Leave false for a Node/Next.js deployment with the server API routes enabled.
NEXT_PUBLIC_USE_SUPABASE_EDGE_API=false

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
INTERNAL_SYNC_API_TOKEN=replace-with-a-long-random-secret

# Enable only when Nginx/Cloudflare overwrites incoming proxy IP headers.
TRUST_PROXY_HEADERS=false

# Optional best-effort public-IP geolocation. The provider URL must contain
# {ip}. Local and private addresses never leave the server.
IP_GEOLOCATION_URL=https://approved-provider.example/v1/{ip}
IP_GEOLOCATION_API_TOKEN=replace-with-provider-token
IP_GEOLOCATION_AUTH_HEADER=Authorization
PYTHON_BIN=python3

# Optional dedicated key for AES-256-GCM broker-password encryption. Use a
# random value of at least 32 bytes. If omitted, the server derives a separate
# encryption key from SUPABASE_SECRET_KEY.
BROKER_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
